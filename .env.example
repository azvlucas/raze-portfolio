# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo

# Local PostgreSQL only. Use a secret-managed URL outside local development.
DATABASE_URL=postgresql://raze_local:local_only_password@localhost:5433/raze_portfolio?schema=public

# Generate independent random values before running the app or seed.
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-at-least-16-characters
SEED_SELLER_EMAIL=seller@example.test
SEED_SELLER_PASSWORD=replace-with-at-least-16-characters

# Optional
# DAYS_TO_EXPIRY_ALERT=30
